{
  "name": "@stellar-thorn/agent-guard",
  "version": "0.1.0",
  "description": "Transaction firewall and on-chain spending limits for autonomous agent wallets on Stellar: SDK + `baret` CLI.",
  "license": "MIT",
  "author": "Aeztrest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeztrest/Baret-Stellar.git",
    "directory": "packages/agent-guard"
  },
  "homepage": "https://github.com/Aeztrest/Baret-Stellar/tree/main/packages/agent-guard#readme",
  "bugs": {
    "url": "https://github.com/Aeztrest/Baret-Stellar/issues"
  },
  "keywords": [
    "stellar",
    "soroban",
    "agent",
    "wallet",
    "x402",
    "spending-limit",
    "transaction-security",
    "passkey-kit"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "baret": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./spend-policy": {
      "types": "./dist/spend-policy.d.ts",
      "import": "./dist/spend-policy.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "baret": "node ./dist/cli.js",
    "spend-policy": "tsx scripts/spend-policy.ts",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.2.1"
  },
  "devDependencies": {
    "@stellar-thorn/swig-guard": "workspace:*",
    "@types/node": "^26.6.4",
    "passkey-kit": "^0.19.1",
    "passkey-kit-sdk": "^0.9.0",
    "tsup": "^8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
