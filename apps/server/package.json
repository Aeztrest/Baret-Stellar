{
  "name": "@stellar-thorn/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "x402-setup": "tsx src/scripts/x402-setup.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "@stellar/stellar-sdk": "^16.2.0",
    "@x402/core": "~2.22.0",
    "@x402/stellar": "~2.22.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
