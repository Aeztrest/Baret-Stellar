{
  "name": "@stellar-thorn/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "x402-setup": "tsx src/scripts/x402-setup.ts",
    "chain-check": "tsx src/scripts/chain-check.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "@stellar/stellar-sdk": "^17.1.0",
    "@x402/core": "~2.26.0",
    "@x402/stellar": "~2.26.0",
    "dotenv": "^18.0.1",
    "fastify": "^5.12.5",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
